# from tvm.script import tirx as T

@T.prim_func
def embedding_kernel(input_ids_handle: T.handle, weight_handle: T.handle, out_handle: T.handle):
    input_ids = T.match_buffer(input_ids_handle, (5,), "int32", strides=(1,))
    weight = T.match_buffer(weight_handle, (512, 128), strides=(128, 1))
    out = T.match_buffer(out_handle, (5, 128), strides=(128, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(5, thread="blockIdx.x"):
        for tx in T.thread_binding(256, thread="threadIdx.x"):
            for ty in T.thread_binding(1, thread="threadIdx.y"):
                for tz in T.thread_binding(1, thread="threadIdx.z"):
                    with T.sblock("tilelang_root"):
                        T.reads()
                        T.writes()
                        for ti in T.parallel(1):
                            token_idx: T.int32 = bx + ti
                            row: T.int32 = input_ids[token_idx]
                            for j in range(128):
                                out[token_idx, j] = weight[row, j]